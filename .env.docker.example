IRIS_PASSWORD=CHANGE_ME
# Puertos asignados a noshow en la tabla de HTC21-ARQUITECTURA.md §3.
# No cambiar salvo que se actualice esa tabla: ppto-ventas usa 52774/1973 y
# manten usa 52775/1974, todos en 127.0.0.1, para evitar colisión al levantar
# los tres a la vez.
IRIS_WEB_PORT=52773
IRIS_SUPERSERVER_PORT=1972
# container_name (noshow-iris) e image (noshow-iris:2026.1-chat, construida desde
# docker/Dockerfile) son fijos en docker-compose.yml, no configurables por
# variable de entorno.
# WORKSPACE_DIR: no definir una ruta absoluta de máquina.
# docker-compose.yml usa ${WORKSPACE_DIR:-.}, que resuelve al directorio del
# proyecto. Dejarla sin definir salvo que el compose se ejecute desde otro lugar.

# Chat (/csp/mlchat) — opcionales. Sin ANTHROPIC_API_KEY el contenedor levanta
# igual: /csp/mlchat/health responde OK, /csp/mlchat/chat devuelve 503 explícito.
ANTHROPIC_API_KEY=
IRIS_TOKEN=demo-readonly-token
